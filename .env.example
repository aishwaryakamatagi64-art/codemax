# Copy this file to .env and fill in your values. Never commit .env.
# MongoDB Atlas (free) or local MongoDB connection string:
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inkwell?retryWrites=true&w=majority
# Local MongoDB alternative: MONGODB_URI=mongodb://127.0.0.1:27017/inkwell
TOKEN_SECRET=change-this-to-a-long-random-string
PORT=3000
